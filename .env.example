# cortex-api settings. Copy to .env and fill in the values you need:
#   cp .env.example .env
# Every setting the code reads is listed here (app/config.py is the source of
# truth for defaults; tests/foundation/test_env_example.py keeps this file in
# sync). Never commit a real key: .env is gitignored, this file holds no secrets.

# --------------------------------------------------------------------------- #
# Runtime
# --------------------------------------------------------------------------- #
# Unset = "production". Only an explicit "local" allows the local conveniences:
# starting without API keys and CORTEX_AUTH_DISABLED (see "API keys" below).
# Any other value refuses to start without CORTEX_API_KEYS_JSON.
# This file is read from the repository folder (next to app/), whatever the
# working directory is. It is optional: without it, settings come from the
# process environment (that is how the Docker image runs).
APP_ENV=local
# Port of the API (uvicorn in the container and the published host port).
# 8100 by default: the legacy Backend keeps 8000.
API_PORT=8100
# Number of uvicorn worker processes. Unset = 1 when run directly, 4 under
# docker compose. Uncomment to force a value in both.
# CORTEX_API_WORKERS=1
# Threads per worker for blocking LLM calls. 0 = Python default.
CORTEX_API_THREAD_WORKERS=0

# --------------------------------------------------------------------------- #
# Postgres and Redis
# --------------------------------------------------------------------------- #
# Inside docker compose the services are reached on their standard ports.
DATABASE_URL=postgresql+asyncpg://cortex:cortex@postgres:5432/cortex
REDIS_URL=redis://redis:6379/0
# Running the API on the host against the compose services instead:
#   DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5433/cortex
#   REDIS_URL=redis://localhost:6380/0
# Host ports published by docker compose (read by docker-compose.yml only).
# Defaults avoid a local Postgres on 5432 and a local Redis on 6379.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
# true: case state falls back to process memory if Redis fails (unsafe with
# several workers). false: Redis failures fail loudly.
# Unset = true when run directly, false under docker compose. Uncomment to
# force a value in both.
# CORTEX_REDIS_FALLBACK_ENABLED=false

# --------------------------------------------------------------------------- #
# Layer 2 data
# --------------------------------------------------------------------------- #
# Folder that contains air/, sea/ and road/. Empty = the repository's data/
# folder, resolved from the code location (never from the working directory).
# The API refuses to start if a required data file is missing or invalid.
CORTEX_DATA_DIR=
# Provider label written into the provenance of Layer 2 facts: mock | live.
# Keep "mock": every block currently answers from the local reference files.
LAYER2_PROVIDER=mock
# Optional per-block labels, format BLOCK-ID=mock|live, comma separated.
LAYER2_PROVIDER_OVERRIDES=

# --------------------------------------------------------------------------- #
# API keys (temporary, replaced by the tenants table in Wave 2)
# --------------------------------------------------------------------------- #
# JSON object: sha256 hex digest of each API key -> tenant id. The raw key is
# never stored. Clients send the raw key in the X-API-Key header on /api/v1/*.
# Hash a key with:
#   python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" 'the-key'
# Replace the placeholder below with the hash of your key. The API refuses to
# start while the placeholder is there (it is not a sha256 digest).
# Authentication is ON by default and fails closed:
#   - no key and APP_ENV other than local: the API refuses to start;
#   - no key (empty value) and APP_ENV=local: the API starts and refuses every
#     /api/v1 request (401 without a key, 403 with one).
CORTEX_API_KEYS_JSON={"PASTE_SHA256_HEX_OF_YOUR_API_KEY_HERE":"tenant-local"}
# true = authentication OFF. Local development only: it is honoured only
# together with APP_ENV=local, and the API refuses to start with it anywhere
# else. The keys above are then not read.
CORTEX_AUTH_DISABLED=false

# --------------------------------------------------------------------------- #
# LLM providers
# --------------------------------------------------------------------------- #
# LLM provider: none | openai | google | ollama
LLM_PROVIDER=google

# Optional per-layer provider overrides. Leave empty to use LLM_PROVIDER.
# Recommended local trial:
#   LLM_INTAKE_PROVIDER=ollama
#   LLM_LAYER3_PROVIDER=google
#   LLM_LAYER4_PROVIDER=ollama
LLM_INTAKE_PROVIDER=
LLM_LAYER3_PROVIDER=
LLM_LAYER4_PROVIDER=

# OpenAI fields are ignored when LLM_PROVIDER=google
LLM_MODEL=
LLM_API_KEY=

# Google / Gemini / Gemma
# Keep the same key in all 3 names to satisfy your app + LangChain integrations.
GOOGLE_AI_API_KEY=PASTE_YOUR_REAL_KEY_HERE
GOOGLE_API_KEY=PASTE_YOUR_REAL_KEY_HERE
GEMINI_API_KEY=PASTE_YOUR_REAL_KEY_HERE

# Main/default model.
# IMPORTANT: use bare model name for LangChain/app config, not "models/gemma-4-31b-it".
GOOGLE_AI_MODEL=gemma-4-31b-it

# Per-layer models. Empty falls back as described.
# Intake model (Layer 1). Empty = GOOGLE_AI_MODEL.
GOOGLE_AI_INTAKE_MODEL=gemma-4-31b-it
# Layer 3 Analyst/Critic model. Empty = GOOGLE_AI_MODEL.
GOOGLE_AI_LAYER3_MODEL=gemma-4-31b-it
# Layer 4 Report Agent model. Empty = GOOGLE_AI_LAYER3_MODEL, then GOOGLE_AI_MODEL.
GOOGLE_AI_LAYER4_MODEL=

# Gemini 2.5 thinking budget controls.
# -2 = do not send the parameter, -1 = dynamic, 0 = disabled where supported,
# positive integer = cap thinking tokens.
GOOGLE_AI_THINKING_BUDGET=-2
GOOGLE_AI_INTAKE_THINKING_BUDGET=-2
GOOGLE_AI_LAYER3_THINKING_BUDGET=-2
GOOGLE_AI_LAYER4_THINKING_BUDGET=0

# Ollama / local models.
# If the API runs inside Docker Desktop on macOS, use host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Per-layer models. Empty = OLLAMA_MODEL.
OLLAMA_INTAKE_MODEL=qwen3:8b
OLLAMA_LAYER3_MODEL=
OLLAMA_LAYER4_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0

# Output token caps per layer (0 or less = provider default).
INTAKE_MAX_OUTPUT_TOKENS=2048
LAYER3_MAX_OUTPUT_TOKENS=4096
LAYER4_MAX_OUTPUT_TOKENS=4096

# --------------------------------------------------------------------------- #
# Orchestrator, payload sizes and debug traces
# --------------------------------------------------------------------------- #
# Redis artifact cache for /api/v1/cortex/full-message.
ORCHESTRATOR_CACHE_ENABLED=true
ORCHESTRATOR_CACHE_TTL_SECONDS=604800
# Include the full Layer 1-4 artifacts in the full-message response.
FULL_RESPONSE_INCLUDE_ARTIFACTS=false
# Log a warning above these sizes.
PROMPT_SIZE_WARN_CHARS=40000
PAYLOAD_SIZE_WARN_BYTES=120000
# Write full prompts/responses of agent runs to files (debug only: they can
# contain customer text). Off by default.
CORTEX_TRACE_FULL_PROMPTS=false
CORTEX_TRACE_ARTIFACT_DIR=/tmp/cortex-agent-traces

# --------------------------------------------------------------------------- #
# LangSmith tracing
# --------------------------------------------------------------------------- #
# OFF by default. Turning it on sends prompts and model outputs to LangSmith
# (a third party). Only enable it deliberately, with data you may share.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cortex-api
# Optional LangSmith API endpoint (read by the langsmith library; e.g. the EU
# region). Leave commented out for the default endpoint.
# LANGSMITH_ENDPOINT=
